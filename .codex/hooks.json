{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/agent_guard.py\" codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
